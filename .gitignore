# --- Ignorar archivos de VS Code ---
.vscode/

# --- Ignorar archivos de sistema ---
.DS_Store
Thumbs.db

# --- Ignorar archivos de XAMPP / Servidor Local ---

*.log
*.tmp
# Ignorar carpetas de configuración del IDE que no sirven en otros equipos
nbproject/

# Ignorar carpeta de herramientas/temporales creada por el equipo
tools/

/vendor/

# Ignore environment variables
.env

# Fotos de productos subidas desde el sistema (se conserva la carpeta)
frontend/src/public/uploads/productos/*
!frontend/src/public/uploads/productos/.gitkeep
